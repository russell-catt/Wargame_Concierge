# Python / tooling
.venv/
__pycache__/
*.pyc
*.egg-info/

# Secrets — never commit
.env
.env.*
secrets/
credentials.json
*.pem
*.key

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Scratchpad / ephemeral (Rising Tide pattern)
scratchpad/
Scratchpad/
**/scratchpad/**

# GW official binaries — NEVER commit (path pointers in markdown OK)
*.pdf
*.PDF
*.webp
*.WEBP
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.tif


# Warcode free beta rulebook only — RedMakers public beta (not GW)
!raw/the_warcode/
!raw/the_warcode/**
!raw/the_warcode/*.pdf
!raw/the_warcode/*.PDF
!raw/the_warcode/**/*.pdf
!raw/the_warcode/**/*.PDF
!raw/the_warcode/**/*.xlsx
!raw/the_warcode/**/*.png

# Allow markdown and Obsidian vault config
!**/*.md
!.obsidian/**
!.obsidian/**/*

# VIP agentic review — local + PDF email only; not on GitHub (owner 2026-08-25)
# Must follow !**/*.md so this ignore wins
games/the_warcode/reviews/Agentic_Rules_and_Marketing_Review.md

# Sep 30 owner pastes are Apple Note zips renamed .md, with GW images inside.
# Must follow !**/*.md so this ignore wins. Do not commit the folder.
raw/dataslate_Sep30/
raw/dataslate_Sep30/**

# Build / output (future)
output/**
!output/README.md
